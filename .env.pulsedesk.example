# Node.js 24.x. Copy to .env.pulsedesk. The old .env is never read.
# demo: no Telegram/network access; polling / webhook: real private Telegram bot.
PULSE_MODE=demo
PULSE_HOST=127.0.0.1
PULSE_PORT=4141
# PULSE_DATABASE=data/pulsedesk-live.sqlite
PULSE_INTERVAL_SECONDS=60
PULSE_FAILURE_THRESHOLD=2
PULSE_MAX_MONITORS=30

# Required only for polling/webhook. Use a NEW bot created with @BotFather.
PULSE_BOT_TOKEN=
PULSE_ALLOWED_USER_IDS=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PULSE_ADMIN_API_KEY=

# Webhook mode: HTTPS origin without trailing slash, and a separate random secret.
PULSE_PUBLIC_ORIGIN=
PULSE_WEBHOOK_SECRET=
