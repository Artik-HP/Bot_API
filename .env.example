# Node.js 24.x. Copy to .env.pulsedesk. The old .env is never read.
# demo: no Telegram/network access; polling / webhook: real private Telegram bot.
PULSE_MODE=demo
PULSE_HOST=127.0.0.1
PULSE_PORT=4141
# PULSE_DATABASE=data/pulsedesk-live.sqlite
PULSE_INTERVAL_SECONDS=60
PULSE_FAILURE_THRESHOLD=2
PULSE_MAX_MONITORS=30

# Required only for polling/webhook. Use a NEW bot created with @BotFather.
PULSE_BOT_TOKEN=
PULSE_ALLOWED_USER_IDS=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PULSE_ADMIN_API_KEY=

# Webhook mode: HTTPS origin without trailing slash, and a separate random secret.
PULSE_PUBLIC_ORIGIN=
PULSE_WEBHOOK_SECRET=

# AI-ассистент через OpenRouter (https://openrouter.ai/keys). Без ключа AI выключен, бот работает как раньше.
PULSE_OPENROUTER_API_KEY=
PULSE_AI_MODEL=openai/gpt-6.1-sol
# none, minimal, low, medium, high
PULSE_AI_REASONING=low
PULSE_AI_MAX_OUTPUT_TOKENS=1200
PULSE_AI_DAILY_LIMIT=150
PULSE_AI_PAGE_RECHECK_MINUTES=15
# PULSE_AI=off — выключить AI, не удаляя ключ.

# Отчёт подписчикам: off, daily или weekly (по понедельникам). В демо не рассылается.
PULSE_DIGEST=weekly
PULSE_DIGEST_HOUR=9
PULSE_TIMEZONE=Europe/Kyiv
