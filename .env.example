BOT_TOKEN=123456789:replace_with_your_telegram_bot_token
API_KEY=replace_with_a_long_random_secret
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_PROVIDER=openai
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_OUTPUT_TOKENS=700
OPENROUTER_REQUEST_TIMEOUT_MS=60000
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_TRANSCRIPTION_TIMEOUT_MS=60000

# Bot-to-bot HTTP protocol
# Each peer must run this app and expose POST /bots/messages.
BOT_NAME=Bot_API
BOT_PEERS_JSON={}
# Example: BOT_PEERS_JSON={"helper":{"url":"https://helper-bot.example.com","apiKey":"replace_with_helper_bot_api_key"}}
BOT_TO_BOT_REQUEST_TIMEOUT_MS=60000
BOT_TO_BOT_MAX_HOPS=3
BOT_TO_BOT_MAX_TEXT_LENGTH=10000

# Telegram group bot-to-bot bridge.
# Telegram may still block bot messages from reaching other bots; this allows replies
# when Telegram delivers an allowed bot message to this instance.
CHAT_ID=-1003996551226
BOT_TO_BOT_ENABLED=true
BOT_TO_BOT_CHAT_ID=-1003996551226
BOT_USERNAME=bot_API_TL_bot
OTHER_BOT_USERNAME=artik_ai_helper_bot
BOT_TO_BOT_ALLOW_BOTS=
BOT_TO_BOT_MAX_TURNS=3
BOT_TO_BOT_TURN_WINDOW_MS=600000

# Delay before ordinary Telegram replies. Set to 0 for immediate replies.
TELEGRAM_REPLY_DELAY_MS=15000
PORT=3000

# The app itself listens over HTTP.
# Use your hosting platform or reverse proxy for public HTTPS.

# polling - bot receives updates by long polling
# webhook - bot receives updates at POST /telegram/webhook
# off - HTTP API only, useful for local smoke tests
BOT_MODE=polling

# Required only for BOT_MODE=webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_AUDIO_MAX_BYTES=20971520
TELEGRAM_FILE_DOWNLOAD_TIMEOUT_MS=60000
REQUEST_BODY_LIMIT=5mb
