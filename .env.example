BOT_TOKEN=123456789:replace_with_your_telegram_bot_token
API_KEY=replace_with_a_long_random_secret
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_PROVIDER=openai
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_OUTPUT_TOKENS=700
OPENROUTER_REQUEST_TIMEOUT_MS=60000
PORT=3000

# The app itself listens over HTTP.
# Use your hosting platform or reverse proxy for public HTTPS.

# polling - bot receives updates by long polling
# webhook - bot receives updates at POST /telegram/webhook
# off - HTTP API only, useful for local smoke tests
BOT_MODE=polling

# Required only for BOT_MODE=webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

TELEGRAM_API_BASE_URL=https://api.telegram.org
REQUEST_BODY_LIMIT=5mb
